generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RESCHEDULED
  COMPLETED
}

enum ConversationType {
  PATIENT_CARE
  DOCTOR_ADMIN
  DOCTOR_PATIENT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CatalogType {
  SPECIALTY
  URGENT_CARE
  SERVICE
}

enum MedicalFileSource {
  UPLOAD
  CONSULTATION
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  passwordHash          String?
  googleId              String?   @unique
  fullName              String
  role                  Role      @default(PATIENT)
  phone                 String?
  avatarUrl             String?
  isActive              Boolean   @default(true)
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  doctorProfile         DoctorProfile?

  appointmentsAsPatient Appointment[]  @relation("AppointmentPatient")
  appointmentsAsDoctor  Appointment[]  @relation("AppointmentDoctor")
  consultationsAsPatient Consultation[] @relation("ConsultationPatient")
  consultationsAsDoctor  Consultation[] @relation("ConsultationDoctor")

  participants          ConversationParticipant[]
  messages              Message[]
  payments              Payment[]
  notesAbout            PatientNote[]  @relation("NotePatient")
  notesAuthored         PatientNote[]  @relation("NoteAuthor")
  medicalFiles          MedicalFile[]

  @@map("users")
}

model DoctorProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  specialty       String
  bio             String?
  defaultMeetLink String?
  availability    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("doctor_profiles")
}

model Appointment {
  id              String        @id @default(uuid()) @db.Uuid
  patientId       String        @db.Uuid
  doctorId        String?       @db.Uuid
  fullName        String
  email           String
  phoneNumber     String
  appointmentType String
  date            String
  time            String
  reason          String
  status          BookingStatus @default(PENDING)
  rescheduleInfo  Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  patient User  @relation("AppointmentPatient", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User? @relation("AppointmentDoctor", fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("appointments")
}

model Consultation {
  id               String        @id @default(uuid()) @db.Uuid
  patientId        String        @db.Uuid
  doctorId         String?       @db.Uuid
  fullName         String
  email            String
  phoneNumber      String
  consultationType String
  date             String
  time             String
  reason           String
  status           BookingStatus @default(PENDING)
  rescheduleInfo   Json?
  fileUrl          String?
  fileName         String?
  googleMeetLink   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  patient      User          @relation("ConsultationPatient", fields: [patientId], references: [id], onDelete: Cascade)
  doctor       User?         @relation("ConsultationDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  medicalFiles MedicalFile[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("consultations")
}

model Conversation {
  id        String           @id @default(uuid()) @db.Uuid
  type      ConversationType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([type])
  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("NGN")
  method       String
  status       PaymentStatus @default(PENDING)
  description  String
  chatEntitled Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model CatalogItem {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  type        CatalogType
  price       Decimal?    @db.Decimal(12, 2)
  currency    String?     @default("NGN")
  description String
  published   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("catalog_items")
}

model PatientNote {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient User @relation("NotePatient", fields: [patientId], references: [id], onDelete: Cascade)
  author  User @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([authorId])
  @@map("patient_notes")
}

model MedicalFile {
  id             String            @id @default(uuid()) @db.Uuid
  ownerId        String            @db.Uuid
  fileName       String
  fileUrl        String
  source         MedicalFileSource @default(UPLOAD)
  consultationId String?           @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@map("medical_files")
}
